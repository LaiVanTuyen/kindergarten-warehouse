# ===========================================================
# Bản dùng thử cho giáo viên — mẫu biến môi trường
# ===========================================================
# Chép thành .env.trial TRÊN MÁY CHỦ (không commit), chmod 600, rồi điền:
#   - các dòng <...> bằng giá trị thật
#   - các secret: chạy ./scripts/generate-secrets.sh và chép sang
# Xem docs/TRIAL_DEPLOYMENT.md.
# ===========================================================

STACK_PREFIX=warehouse_trial
# prod: Flyway + ddl-auto=validate, tắt Swagger. demo: cookie Lax same-origin, tắt Rollbar.
SPRING_PROFILES_ACTIVE=prod,demo
DOMAIN_NAME=<thu-nghiem.programmingwithtuyen.com>

# Cổng chỉ bind 127.0.0.1 (xem docker-compose.yml). Không mở ra Internet:
# Cloudflare Tunnel đi từ trong ra, không cần mở port trên Oracle.
MYSQL_PORT_HOST=3306
REDIS_PORT_HOST=6379
MINIO_PORT_HOST=9000
MINIO_CONSOLE_PORT_HOST=9001
APP_PORT=8080
PORTAL_PORT_HOST=4301
ADMIN_PORT_HOST=4300

MYSQL_DATABASE=warehouse
MYSQL_USER=warehouse
MYSQL_PASSWORD=<generate>
MYSQL_ROOT_PASSWORD=<generate>
REDIS_PASSWORD=<generate>

# MinIO chạy ngay trên máy chủ (không dùng R2: R2 không có bucket policy nên
# không giữ được tệp học liệu riêng tư mà vẫn hiện thumbnail công khai).
MINIO_ROOT_USER=warehouse-minio
MINIO_ROOT_PASSWORD=<generate>
MINIO_BUCKET_NAME=warehouse-trial-bucket
# Rỗng = đường dẫn tương đối /<bucket>/<key>, được nginx của Portal/Admin proxy same-origin.
MINIO_PUBLIC_ENDPOINT=
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

JWT_SECRET=<generate>
JWT_EXPIRATION=86400000

# Tài khoản ADMIN đầu tiên (DataSeeder tạo khi khởi động lần đầu).
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=<email-quan-tri@truong.edu.vn>
APP_ADMIN_PASSWORD=<generate>

CORS_ALLOWED_ORIGINS=https://<thu-nghiem.programmingwithtuyen.com>,https://<admin-thu-nghiem.programmingwithtuyen.com>
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# Email OTP khi tự đăng ký. Bỏ trống thì giáo viên KHÔNG tự đăng ký được —
# quản trị viên tạo tài khoản giáo viên trong trang Admin (khuyên dùng cho bản thử).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=not-configured@example.com
MAIL_PASSWORD=not-configured

ROLLBAR_ACCESS_TOKEN=
ROLLBAR_ENABLED=false
ROLLBAR_ENV=trial
YOUTUBE_API_KEY=

# Trợ lý AI (tuỳ chọn). Để trống = ẩn trợ lý. Chỉ bật khi nhà trường đồng ý
# gửi nội dung kế hoạch (không có tên, email hay thông tin trẻ) tới Anthropic.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_LIMIT=30

# Token của Cloudflare Tunnel (Zero Trust → Networks → Tunnels → Create → Docker).
CLOUDFLARE_TUNNEL_TOKEN=<token>

ANGULAR_DIST=../kindergarten-warehouse-angular/dist/apps
